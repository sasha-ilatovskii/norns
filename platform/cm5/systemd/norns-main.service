[Unit]
Description=norns main process for CM5
After=norns-jack.service norns-sclang.service
Requires=norns-jack.service
PartOf=norns.target

[Service]
Type=simple
User=me
Group=me
SupplementaryGroups=audio spi gpio
Environment=HOME=/home/me
Environment=USER=me
WorkingDirectory=/home/me/norns
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStart=/home/me/norns/build/ws-wrapper/ws-wrapper ws://*:5555 /home/me/norns/build/norns/norns
Restart=always
RestartSec=500ms

[Install]
WantedBy=norns.target
