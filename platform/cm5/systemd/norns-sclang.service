[Unit]
Description=norns SuperCollider language server for CM5
After=norns-jack.service
Requires=norns-jack.service
PartOf=norns.target

[Service]
Type=simple
User=me
Group=me
SupplementaryGroups=audio
Environment=HOME=/home/me
Environment=USER=me
WorkingDirectory=/home/me/norns
LimitRTPRIO=95
LimitMEMLOCK=infinity
ExecStart=/home/me/norns/build/ws-wrapper/ws-wrapper ws://*:5556 /usr/bin/sclang -i maiden
Restart=always
RestartSec=500ms

[Install]
WantedBy=norns.target
